# DEV (mặc định): SQLite, schema.prisma để provider = "sqlite"
DATABASE_URL="file:./dev.db"

# PROD (Vercel): Postgres từ Neon/Supabase + đổi provider = "postgresql" trong schema.prisma
# Neon: lấy chuỗi có "-pooler" trong host — serverless mở/đóng kết nối liên tục,
# không pooled sẽ hết connection slot. Thêm ?sslmode=require nếu chuỗi chưa có.
# DATABASE_URL="postgresql://user:pass@host-pooler.region.aws.neon.tech/db?sslmode=require"

# Bí mật ký JWT session + mã hoá token cổng rút gọn.
# Sinh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Mật khẩu admin dạng bcrypt hash.
# Sinh: node scripts/hash-password.mjs "mat-khau-cua-ban"
# QUAN TRỌNG: file .env chạy qua dotenv-expand, "$2b$12$" bị hiểu là biến môi trường
# và bị xoá. Phải escape mỗi dấu $ thành \$ — script trên đã in ra sẵn dòng đúng.
# Ví dụ: ADMIN_PASSWORD_HASH="\$2b\$12\$ShkutLXWOZ..."
ADMIN_PASSWORD_HASH=""

# Domain thật của site. Bắt buộc ở prod: dùng để build link /hop và /key
# gửi cho cổng rút gọn (không có thì cổng không biết trỏ về đâu).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Tùy chọn: chỉ cho phép truy cập qua host này (chống clone). Để trống = tắt.
ALLOWED_HOST=""
